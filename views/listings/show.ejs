<% layout ("/layouts/boilerplate.ejs") %>
<section class="detail-page">
    <div class="detail-page__top">
        <a class="button button--secondary" href="/listings">
            <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="m15 18-6-6 6-6"/>
            </svg>
            All stays
        </a>
        <div class="detail-page__actions">
            <a class="button button--secondary" href="/listings/<%= listing._id %>/edit">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="m16 4 4 4L8 20H4v-4L16 4Z"/><path d="m14 6 4 4"/>
                </svg>
                Edit
            </a>
            <form action="/listings/<%= listing._id %>?_method=DELETE" method="POST">
                <button class="button button--danger" type="submit">
                    <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 6h18M8 6V4h8v2m3 0-1 14H6L5 6m4 4v6m6-6v6"/>
                    </svg>
                    Delete
                </button>
            </form>
        </div>
    </div>

    <article class="detail-card">
        <img class="detail-card__image" src="<%= listing.image %>" alt="<%= listing.title %>">
        <div class="detail-card__body">
            <p class="page-eyebrow">A place to make memories</p>
            <h1><%= listing.title %></h1>
            <p class="detail-card__location">
                <svg aria-hidden="true" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 10c0 5-8 12-8 12S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/>
                </svg>
                <%= listing.location %><% if (listing.country) { %>, <%= listing.country %><% } %>
            </p>
            <p class="detail-card__description"><%= listing.description %></p>
            <p class="detail-card__price">
                &#8377; <%= listing.price.toLocaleString('en-IN') %>
                <span>per night</span>
            </p>
        </div>
    </article>
</section>
